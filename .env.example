# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://weknoq:yourpassword@localhost:5432/weknoq"
POSTGRES_PASSWORD="yourpassword"

# ─── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Google OAuth (for Sign in with Google) ────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── YouTube Data API v3 ───────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/api/youtube.googleapis.com
# Free quota: 10,000 units/day
YOUTUBE_API_KEY=""

# Used to protect POST /api/youtube/ingest (send as `x-api-key` header)
INGEST_API_KEY="change-me"

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── AI Tagger (optional — leave blank to use rule-based tagging)
OPENAI_API_KEY=""
# For self-hosted Ollama (free): set OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST=""

# ─── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="Weknoq"
